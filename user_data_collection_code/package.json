{
	"name": "anonymous-ide-assistant-root",
	"version": "0.0.0",
	"license": "MIT",
	"scripts": {
		"prepare": "husky install",
		"lint-staged": "lint-staged",
		"build-all": "pnpm nx run-many --target=build",
		"build-extension": "pnpm nx run vscode:test",
		"start": "cd ./webUI && pnpm run start",
		"start:enterprise": "node ./parseYml.js enterprise && cd ./webUI  && pnpm run start",
		"test": "pnpm nx run extension:test",
		"test-watch": "pnpm nx run extension:test-watch",
		"deploy:vscode": "node ./parseYml.js package && pnpm nx run vscode:publish-vscode --verbose",
		"deploy:ovsx": "node ./parseYml.js package && pnpm nx run vscode:publish-ovsx",
		"assistant": "node ./tools/scripts/cli/index.js"
	},
	"private": true,
	"devDependencies": {
		"@biomejs/biome": "2.3.4",
		"@types/archiver": "^6.0.2",
		"@types/crypto-js": "^4.0.2",
		"@types/diff": "5.2.0",
		"@types/diff-match-patch": "^1.0.36",
		"@types/fs-extra": "^11.0.4",
		"@types/markdown-it": "^14.1.2",
		"@types/node": "^18.19.130",
		"@types/node-forge": "^1.3.1",
		"@types/pdf-parse": "^1.1.4",
		"@types/sanitize-html": "^2.16.0",
		"@types/uuid": "^8.3.2",
		"@types/vscode": "1.82.0",
		"@typescript-eslint/eslint-plugin": "^5.49.0",
		"@typescript-eslint/parser": "^5.49.0",
		"@vscode/vsce": "2.16.0",
		"chalk": "4.1.2",
		"commander": "14.0.2",
		"diff": "5.2.0",
		"esbuild": "0.16.10",
		"eslint": "^8.32.0",
		"eslint-config-prettier": "8.6.0",
		"husky": "^8.0.0",
		"jszip": "3.7.1",
		"lint-staged": "13.1.0",
		"nx": "15.4.1",
		"ovsx": "0.8.0",
		"prettier": "2.8.3",
		"shelljs": "0.8.5",
		"typescript": "4.9.4",
		"vite": "5.4.21"
